{
	"name": "freebuff-appli",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "convex dev --start \"npm run dev:web\"",
		"dev:web": "vite dev",
		"dev:convex": "convex dev",
		"build": "vite build",
		"deploy": "node scripts/deploy.mjs",
		"setup:coach": "node scripts/setup-coach.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
