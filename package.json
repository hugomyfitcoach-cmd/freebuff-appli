		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.4.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@lucide/svelte": "^1.42.0",
		"convex": "^1.45.0",
		"html5-qrcode": "^2.3.8"
